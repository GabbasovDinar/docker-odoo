{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Odoo: Docker Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/local-addons",
          "remoteRoot": "/opt/local-addons"
        }
      ],
      "justMyCode": false
    }
  ]
}
