    <template id="page_blog" name="FiliaTech Blog">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'filiatech_blog'"/>
            <section class="filiatech-hero py-5">
                <div class="digital-grid"></div>
                <div class="container position-relative">
                    <h1 class="fw-bold">Блог FiliaTech</h1>
                    <p class="lead text-light">Статьи про внедрение Odoo, интеграции, автоматизацию и лучшие практики.</p>
                </div>
            </section>
            <section class="filiatech-section">
                <div class="container">
                    <div class="filiatech-card filiatech-blog-list">
                        <t t-set="posts" t-value="request.env['blog.post'].sudo().search([], order='create_date desc')"/>
                        <t t-foreach="posts" t-as="post">
                            <article>
                                <h4 class="mb-1"><a t-att-href="post.website_url" class="text-decoration-none">[[post.name]]</a></h4>
                                <p class="text-muted mb-1" t-field="post.subtitle"/>
                                <small class="text-muted">[[post.create_date.strftime('%d.%m.%Y') if post.create_date else '' ]] · [[post.author_id.name or 'FiliaTech']]</small>
                            </article>
                        </t>
                        <t t-if="not posts">
                            <div class="text-muted">Статей пока нет. Подготовим материалы о наших внедрениях.</div>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

