# docker-odoo example configuration
# Copy to .env and adjust.

###############################################
# Images & build knobs
###############################################
# Images default to ${ODOO_EDITION}-odoo-{base,addons}:${ODOO_VERSION}
ODOO_VERSION=18.0
ODOO_EDITION=ee
ODOO_ORG_REPO=odoo/odoo
POSTGRES_VERSION=16
ADDONS_YML=addons/addons.yml
EXTRA_REQUIREMENTS=addons/requirements.txt

###############################################
# Database connection shared by build/runtime
###############################################
DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo
DB_NAME=
DB_SSLMODE=prefer

###############################################
# Core Odoo settings (public profile)
###############################################
ADMIN_PASSWORD=change-me
INIT=base
WITHOUT_DEMO=True
DEMO=False
LOAD=web
ADDONS_PATH=/opt/odoo/addons,/opt/extra-addons,/opt/local-addons
LOCAL_ADDONS_DIR=./local-addons

DATA_DIR=/var/lib/odoo
# LOGFILE=/var/log/odoo/odoo.log
LOG_LEVEL=info
LIST_DB=True
DBFILTER=.*
HTTP_PORT=8069
# Remember to expose ${GEVENT_PORT} via your reverse proxy when enabling workers.
GEVENT_PORT=8072
XMLRPCS_PORT=8071
REPORT_URL=http://kwkhtmltopdf:8080
WORKERS=0
MAX_CRON_THREADS=1
PROXY_MODE=False
# Additional options appended verbatim to the generated odoo.conf.
# Example (note the multiline value) to enable OCA queue_job channels:
# ODOO_EXTRA_OPTS="
# [queue_job]
# channels = root:2
# "
ODOO_EXTRA_OPTS=

###############################################
# Development profile (uncomment as needed)
###############################################
# DEBUG=1
# DEV_MODE=reload,assets,qweb
# LOG_LEVEL=debug
# WITHOUT_DEMO=False

###############################################
# Production-style profile (behind reverse proxy)
###############################################
# PROXY_MODE=True
# WORKERS=4
# MAX_CRON_THREADS=2
# LIMIT_MEMORY_SOFT=1342177280
# LIMIT_MEMORY_HARD=1610612736
# LIMIT_TIME_CPU=120
# LIMIT_TIME_REAL=240
# LIST_DB=False
# DBFILTER=^mycompany$

###############################################
# Outbound email (optional)
###############################################
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

###############################################
# Git credentials
###############################################
# Provide tokens only when consuming private repositories.
# They are automatically loaded when you pass an envfile secret.
# GITHUB_TOKEN=<your GitHub PAT with repo scope>
# GITLAB_TOKEN=<your GitLab PAT with read_repository scope>
# GITHUB_HOST=github.com
# GITLAB_HOST=gitlab.com
# GITHUB_USER=x-access-token
# GITLAB_USER=oauth2

###############################################
# Enterprise edition settings (optional)
###############################################
# Set ODOO_EDITION=ee to enable fetching enterprise addons.
# Configure the repository and ref for git-aggregator if needed.
# ODOO_ENTERPRISE_REPO=https://github.com/odoo/enterprise.git
# ODOO_ENTERPRISE_REF=18.0
# ODOO_EE_ADDONS_DIR=/opt/enterprise-addons

###############################################
# Compose exposed port override
###############################################
ODOO_HOST_PORT=8069
