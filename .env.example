# docker-odoo example configuration
# Copy to .env and adjust.

###############################################
# Essential settings (adjust these first)
###############################################
# Tag/branch of Odoo to build and run. Matches upstream git tags like 18.0.
ODOO_VERSION=18.0
# Choose the distribution: ce (Community Edition) or ee (Enterprise Edition).
ODOO_EDITION=ce
# Master password required for managing databases from the Odoo UI.
ADMIN_PASSWORD=change-me
# Show the database selector on the login screen (set False for single-tenant).
LIST_DB=True
# Regex used to filter visible databases when LIST_DB=True.
DBFILTER=.*
# Worker pool size. Keep 0 for threaded mode; set >0 when using a reverse proxy.
WORKERS=0
# Friendly database name.
DATABASE_NAME=odoo

###############################################
# Database connection
###############################################
# When rotating DB_PASSWORD you must drop the "db-data" volume
# (for example `docker compose down -v`) so PostgreSQL forgets the old credentials.
DB_PASSWORD=odoo
# Database name
DB_NAME=${DATABASE_NAME}
# Database role used by both the build stage and runtime container.
DB_USER=odoo
# PostgreSQL service hostname as seen from the Odoo container.
DB_HOST=db
# PostgreSQL port.
DB_PORT=5432
# SSL mode passed to psycopg2 (prefer, require, disable...).
DB_SSLMODE=prefer
# Maximum pooled PostgreSQL connections (leave empty for the upstream default).
DB_MAXCONN=
# Template database used when provisioning a new database.
DB_TEMPLATE=
# Location of the PostgreSQL binaries (rarely needed unless custom images).
PG_PATH=

###############################################
# Build context & filesystem paths
###############################################
# PostgreSQL version used by the bundled database container.
POSTGRES_VERSION=16
# git-aggregator manifest consumed during the addons image build.
ADDONS_YML=addons/addons.yml
# Location of the generated odoo.conf inside the container.
ODOO_RC=/etc/odoo.conf
# Base directory for the Odoo source tree.
ROOT_PATH=/opt/odoo
# Where Odoo stores filestore and sessions inside the container.
DATA_DIR=/var/lib/odoo
# Bind-mounted directory with hot-reloadable addons.
LOCAL_ADDONS_DIR=./local-addons
# Combined addons path injected into odoo.conf.
ADDONS_PATH=/opt/odoo/addons,/opt/extra-addons,/opt/local-addons
# Optional extra search path for upgrades.
UPGRADE_PATH=
# Persisted addons to load on startup (comma separated).
LOAD=web

###############################################
# Module loading & demo data
###############################################
# Modules to install when creating the database.
INIT=base
# Additional modules to update on startup.
UPDATE=
# Skip demo data when provisioning the database.
WITHOUT_DEMO=True
# Force demo data even if WITHOUT_DEMO=True.
DEMO=False
# CSV delimiter used by import/export tools.
CSV_INTERNAL_SEP=,
# Only install a subset of data when restoring partial dumps.
IMPORT_PARTIAL=
# Append raw configuration snippets to the rendered odoo.conf.
ODOO_EXTRA_OPTS=
# Toggle gzip compression for generated reports.
REPORTGZ=False
# Telemetry endpoint contacted by publisher warranty services.
PUBLISHER_WARRANTY_URL=https://services.odoo.com/publisher-warranty/
# URL of an external wkhtmltopdf renderer. Leave empty for the bundled binary.
REPORT_URL=

###############################################
# HTTP, proxy & realtime
###############################################
# Interface binding for the classic HTTP server (leave empty for 0.0.0.0).
HTTP_INTERFACE=
# Interface binding for the HTTPS/XML-RPC server.
XMLRPCS_INTERFACE=
# Enable or disable the legacy HTTP/XML-RPC servers.
HTTP_ENABLE=True
XMLRPCS=True
# Public ports exposed by the Odoo services.
HTTP_PORT=8069
XMLRPCS_PORT=8071
GEVENT_PORT=8072
# Honour proxy headers (enable when running behind nginx/traefik).
PROXY_MODE=False
# Allow nginx/apache to serve static files via X-Sendfile.
X_SENDFILE=False

###############################################
# Websocket longpolling
###############################################
# Idle timeout (seconds) before websocket connections are closed.
WEBSOCKET_KEEP_ALIVE_TIMEOUT=
# Burst size allowed before rate limiting websocket connections.
WEBSOCKET_RATE_LIMIT_BURST=
# Delay (seconds) imposed once the rate limit is exceeded.
WEBSOCKET_RATE_LIMIT_DELAY=

###############################################
# Performance, workers & limits
###############################################
# Number of cron worker threads (independent from WORKERS).
MAX_CRON_THREADS=1
# Raise to True to enable the unaccent extension for full-text search.
UNACCENT=
# Hard/soft memory limits (bytes) enforced per worker.
LIMIT_MEMORY_SOFT=
LIMIT_MEMORY_HARD=
# CPU/real time limits (seconds) for RPC calls.
LIMIT_TIME_CPU=
LIMIT_TIME_REAL=
# Real time limit for cron jobs (seconds).
LIMIT_TIME_REAL_CRON=
# Maximum requests a worker can serve before recycling.
LIMIT_REQUEST=
# Legacy ORM record count guard (set -1 to disable).
OSV_MEMORY_COUNT_LIMIT=
# Automatic cleanup threshold for transient models (hours).
TRANSIENT_AGE_LIMIT=

###############################################
# Shell & lifecycle helpers
###############################################
# Custom shell implementation for `odoo shell`.
SHELL_INTERFACE=
# Stop the server after module initialization.
STOP_AFTER_INIT=
# Preserve the rendered configuration on exit.
SAVE=
# Alternative PID file location.
PIDFILE=

###############################################
# Developer tooling & testing
###############################################
# Enable development helpers (comma separated: reload,assets,qweb,...).
DEV_MODE=
# Enable the test runner.
TEST_ENABLE=
# Limit tests to specific modules or files.
TEST_FILE=
# Filter tests by tag expression.
TEST_TAGS=
# Capture screencasts/screenshots during tests.
SCREENCASTS=
SCREENSHOTS=

###############################################
# Logging & diagnostics
###############################################
# Absolute path inside the container for the log file.
LOGFILE=
# Log level (info, debug, warn, error, critical).
LOG_LEVEL=info
# Extra log handlers (e.g. odoo.http:DEBUG).
LOG_HANDLER=
# Store logs inside the database.
LOG_DB=
# Minimum log level persisted in the database.
LOG_DB_LEVEL=
# Forward logs to syslog.
SYSLOG=
# Default sender address when Odoo sends emails.
EMAIL_FROM=
# Additional filter applied to outgoing addresses.
FROM_FILTER=

###############################################
# Email (SMTP)
###############################################
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL_CERTIFICATE_FILENAME=
SMTP_SSL_PRIVATE_KEY_FILENAME=

###############################################
# Internationalisation
###############################################
LOAD_LANGUAGE=
LANGUAGE=
TRANSLATE_OUT=
TRANSLATE_IN=
TRANSLATE_MODULES=
OVERWRITE_EXISTING_TRANSLATIONS=

###############################################
# Geo features
###############################################
GEOIP_DATABASE=

###############################################
# Git credentials for private repositories
###############################################
# Provide tokens only when consuming private repositories.
GITHUB_TOKEN=
GITLAB_TOKEN=
GITHUB_HOST=github.com
GITLAB_HOST=gitlab.com
GITHUB_USER=x-access-token
GITLAB_USER=oauth2

###############################################
# Enterprise edition options
###############################################
# Set ODOO_EDITION=ee to fetch Enterprise addons.
ODOO_EE_ADDONS_DIR=/opt/enterprise-addons
ODOO_ENTERPRISE_REPO=https://github.com/odoo/enterprise.git
ODOO_ENTERPRISE_REF=18.0
