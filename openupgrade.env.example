# Copy this file to .env for an 18 -> 19 migration test.

ODOO_VERSION=19.0
ODOO_EDITION=ce
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

DB_HOST=postgres.example.internal
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=prefer
POSTGRES_VERSION=16

OPENUPGRADE=True
OPENUPGRADE_SOURCE_DATABASE_NAME=odoo18
OPENUPGRADE_TARGET_DATABASE_NAME=odoo19
OPENUPGRADE_TARGET_VERSION=19.0
OPENUPGRADE_RECREATE_DATABASE=False
OPENUPGRADE_FORCE=False
OPENUPGRADE_COPY_FILESTORE=True
OPENUPGRADE_USE_DEMO=
OPENUPGRADE_RENAMED_MODULES=
OPENUPGRADE_MERGED_MODULES=

DATABASE_NAME=odoo19
DB_NAME=${DATABASE_NAME}
LIST_DB=False
DBFILTER=^odoo19$
WORKERS=2
MAX_CRON_THREADS=1

UPGRADE_PATH=/opt/local-addons/upgrade

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
ODOO_BASE_URL=https://localhost
ODOO_REPORT_URL=http://odoo:8069
LOAD=web,session_redis
LOCAL_ADDONS_DIR=./local-addons
