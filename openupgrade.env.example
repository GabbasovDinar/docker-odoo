# Copy this file to .env for a 16 -> 17 migration test.

ODOO_VERSION=17.0
ODOO_EDITION=ce
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# PostgreSQL server containing the source Odoo 16 database.
# The source database is never migrated in place: the entrypoint clones it first.
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=prefer
POSTGRES_VERSION=16

OPENUPGRADE=True
OPENUPGRADE_SOURCE_DATABASE_NAME=odoo16
OPENUPGRADE_TARGET_DATABASE_NAME=odoo17
# Final destination of a multi-hop migration. For 16 -> 17 -> 18 keep this at 18.0.
OPENUPGRADE_TARGET_VERSION=18.0
# Existing target DB is never overwritten unless this is explicitly enabled.
OPENUPGRADE_RECREATE_DATABASE=False
OPENUPGRADE_FORCE=False
# Copy /var/lib/odoo/filestore/<source> to <target> when it is available in this container.
OPENUPGRADE_COPY_FILESTORE=True
OPENUPGRADE_USE_DEMO=
OPENUPGRADE_RENAMED_MODULES=
OPENUPGRADE_MERGED_MODULES=

# Runtime is automatically pinned to OPENUPGRADE_TARGET_DATABASE_NAME.
DATABASE_NAME=odoo17
DB_NAME=${DATABASE_NAME}
LIST_DB=False
DBFILTER=^odoo17$
WORKERS=2
MAX_CRON_THREADS=1

# Optional custom migration scripts outside addon-local migrations/upgrades directories.
UPGRADE_PATH=/opt/local-addons/upgrade

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
ODOO_BASE_URL=https://localhost
ODOO_REPORT_URL=http://odoo:8069
LOAD=web,session_redis
LOCAL_ADDONS_DIR=./local-addons
