# Enable one-step OpenUpgrade migration before normal Odoo startup.
OPENUPGRADE=True

# Name of the COPY of the Odoo 16 database to migrate on DB_HOST.
# Never point this at the production database.
OPENUPGRADE_DATABASE_NAME=odoo_migration_17

# Target must match this repository branch.
OPENUPGRADE_TARGET_VERSION=17.0

# Re-run -u all even if base already reports 17.0.
OPENUPGRADE_FORCE=False

# Optional OpenUpgrade settings.
OPENUPGRADE_USE_DEMO=
OPENUPGRADE_RENAMED_MODULES=
OPENUPGRADE_MERGED_MODULES=

# Optional path for custom upgrade scripts kept outside modules.
# local-addons is already mounted at /opt/local-addons.
UPGRADE_PATH=/opt/local-addons/upgrade
