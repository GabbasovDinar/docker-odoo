# Copy this file to .env for a 16 -> 17 migration test.

ODOO_VERSION=17.0
ODOO_EDITION=ce
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# External PostgreSQL server containing the disposable Odoo 16 database copy.
DATABASE_NAME=odoo_migration_17
DB_NAME=${DATABASE_NAME}
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=prefer
POSTGRES_VERSION=16

# Keep HTTP access pinned to the migrated copy after OpenUpgrade finishes.
LIST_DB=False
DBFILTER=^odoo_migration_17$
WORKERS=2
MAX_CRON_THREADS=1

# OpenUpgrade runs once when base is still on Odoo 16,
# then the same container starts normal Odoo 17 on this database.
OPENUPGRADE=True
OPENUPGRADE_DATABASE_NAME=odoo_migration_17
OPENUPGRADE_TARGET_VERSION=17.0
OPENUPGRADE_FORCE=False
OPENUPGRADE_USE_DEMO=
OPENUPGRADE_RENAMED_MODULES=
OPENUPGRADE_MERGED_MODULES=

# Optional scripts outside the module itself. local-addons is already bind-mounted.
UPGRADE_PATH=/opt/local-addons/upgrade

# Runtime services required by the current Compose stack.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
CADDY_DOMAIN=localhost
CADDY_EMAIL=admin@example.com
ODOO_BASE_URL=https://localhost
ODOO_REPORT_URL=http://odoo:8069
LOAD=web,session_redis
LOCAL_ADDONS_DIR=./local-addons
