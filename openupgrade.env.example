# OpenUpgrade migration: Odoo 18 -> Odoo 19

###############################################
# Odoo build
###############################################

# Target Odoo version for THIS migration step.
ODOO_VERSION=18.0

# ce or ee.
# IMPORTANT:
# If the Odoo 18 database has Enterprise modules installed,
# this must be ee and Enterprise repository credentials must be configured.
ODOO_EDITION=ce

###############################################
# PostgreSQL
###############################################

# PostgreSQL containing source database.
#
# Bundled PostgreSQL:
# DB_HOST=db
#
# External PostgreSQL:
# DB_HOST=10.20.0.15

DB_HOST=CHANGE_ME_POSTGRES_HOST
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM_DB_PASSWORD

# Normal runtime DB after migration.
# During OpenUpgrade the entrypoint also explicitly pins the DB
# to OPENUPGRADE_TARGET_DATABASE_NAME.
DB_NAME=ODOO_19

###############################################
# OpenUpgrade
###############################################

# Enable migration workflow.
OPENUPGRADE=True

# EXISTING source database.
# This database must be Odoo 18.
#
# It is NOT migrated in place.
OPENUPGRADE_SOURCE_DATABASE_NAME=ODOO_18

# NEW database that will become Odoo 19.
OPENUPGRADE_TARGET_DATABASE_NAME=ODOO_19

# False:
#   if ODOO_19 already exists unexpectedly, migration aborts.
#
# True:
#   drop ODOO_19 and recreate it from ODOO_18.
#
# Keep False for the first run.
OPENUPGRADE_RECREATE_DATABASE=False

# Normally False.
#
# This is NOT the normal option for retrying a failed migration.
# For a clean retry use:
#
# OPENUPGRADE_RECREATE_DATABASE=True
#
OPENUPGRADE_FORCE=False

###############################################
# Odoo paths required for migration
###############################################

# Odoo does NOT recursively discover arbitrary nested addon repositories.
#
# If you have:
#
# local-addons/
#   addons/
#       module_a/
#       module_b/
#
# use:
#
# ADDONS_PATH=/opt/odoo/addons,/opt/extra-addons,/opt/local-addons,/opt/local-addons/addons
#
ADDONS_PATH=/opt/odoo/addons,/opt/extra-addons,/opt/local-addons

# Optional directory for project-specific migration scripts.
#
# For example:
#
# local-addons/
#   upgrade/
#

UPGRADE_PATH=/opt/extra-addons/openupgrade_scripts/scripts,/opt/local-addons/upgrade

# Odoo filestore location.
DATA_DIR=/var/lib/odoo

###############################################
# Docker Compose dependencies
###############################################

REDIS_PASSWORD=CHANGE_ME_STRONG_RANDOM_REDIS_PASSWORD

###############################################
# Git credentials
###############################################

# GitHub
GITHUB_TOKEN=
GITHUB_HOST=github.com
GITHUB_USER=x-access-token

# GitLab
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com
GITLAB_USER=oauth2

# Generic Git server
GIT_TOKEN=
GIT_HOST=
GIT_USER=oauth2
