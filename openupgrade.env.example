# Enable one-step OpenUpgrade migration before normal Odoo startup.
OPENUPGRADE=True

# Name of the COPY of the database to migrate on the PostgreSQL server configured by DB_HOST/DB_PORT.
# Never point this at the production database.
OPENUPGRADE_DATABASE_NAME=odoo_migration

# Target must match the repository/Odoo branch running this migration.
# 16 -> 17: use 17.0 branch and target 17.0
# 17 -> 18: use 18.0 branch and target 18.0
OPENUPGRADE_TARGET_VERSION=18.0

# Re-run -u all even if the base module already reports the target version.
# Keep False for normal usage; use only when deliberately developing/retrying scripts.
OPENUPGRADE_FORCE=False

# Optional OpenUpgrade environment supported by openupgrade_framework.
OPENUPGRADE_USE_DEMO=
OPENUPGRADE_RENAMED_MODULES=
OPENUPGRADE_MERGED_MODULES=

# Optional additional Odoo upgrade path for your own scripts.
# The existing local-addons bind mount makes this path available without another Docker mount.
# Example layout:
# local-addons/upgrade/my_module/18.0.1.0/pre-10-migrate.py
# local-addons/upgrade/my_module/18.0.1.0/post-10-migrate.py
UPGRADE_PATH=/opt/local-addons/upgrade
